{
  "name": "scope-creep-console",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "bun install",
    "dev": "react-router dev",
    "run": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "react-router typegen && tsc && biome check && vitest run",
    "format": "biome check --write",
    "healthcheck": "curl -fsS http://localhost:3000/healthz",
    "deploy": "echo 'GATED (INVARIANTS §III): run `fly deploy` yourself.' && exit 1",
    "destroy": "echo 'GATED (INVARIANTS §III): run `fly apps destroy scope-creep-console` yourself.' && exit 1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "@scope-creep/design": "github:dimays/scope-creep-design#v0.1.0",
    "@scope-creep/ext-feedback": "github:dimays/scope-creep-ext-feedback#v0.1.0",
    "@scope-creep/ext-chatbot": "github:dimays/scope-creep-ext-chatbot#v0.1.0",
    "drizzle-orm": "^0.36.4",
    "isbot": "^5.1.36",
    "marked": "^18.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.28.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vitest": "^3.0.0"
  }
}
